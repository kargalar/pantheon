<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:VideoPlayer"
        xmlns:core="clr-namespace:VideoPlayer.Core;assembly=VideoPlayer.Core"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="VideoPlayer.MainWindow"
        Title="Pantheon" Icon="/Assets/pantheon.ico" Width="1120" Height="760"
        WindowDecorations="None" ExtendClientAreaToDecorationsHint="True" CanResize="True" ShowInTaskbar="True"
        Background="#090909" WindowStartupLocation="CenterScreen">
  <Window.WindowDecorationsTheme>
    <!-- The player supplies its own header, including in full screen. -->
    <ControlTheme TargetType="chrome:WindowDrawnDecorations">
      <Setter Property="Template">
        <WindowDrawnDecorationsTemplate>
          <chrome:WindowDrawnDecorationsContent />
        </WindowDrawnDecorationsTemplate>
      </Setter>
    </ControlTheme>
  </Window.WindowDecorationsTheme>
  <Grid x:Name="RootPanel" RowDefinitions="48,*,Auto" ColumnDefinitions="*,Auto" Margin="0">
    <Border x:Name="HeaderBar" Grid.Row="0" Grid.ColumnSpan="2" Background="#181818" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="14,14,10,10"
            IsVisible="False" Opacity="0">
      <Grid ColumnDefinitions="*,Auto">
        <Border x:Name="TitleDragRegion" Background="Transparent">
          <TextBlock x:Name="WindowFileLabel" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2"
                     Margin="15,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,7,0" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Content="⚙" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.Settings}" AutomationProperties.Name="{x:Static core:UiText.Settings}" />
          <Button x:Name="MinimizeButton" Content="−" Classes="caption" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.Minimize}" AutomationProperties.Name="{x:Static core:UiText.Minimize}" />
          <Button x:Name="MaximizeButton" Content="□" Classes="caption" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.Maximize}" AutomationProperties.Name="{x:Static core:UiText.Maximize}" />
          <Button x:Name="CloseButton" Content="×" Classes="caption close" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.Close}" AutomationProperties.Name="{x:Static core:UiText.CloseWindow}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="VideoFrame" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" CornerRadius="0" Background="#090909" BorderThickness="0" ClipToBounds="True">
      <Grid>
        <local:ToneMappedVideoView x:Name="VideoSurface" />
        <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
          <Border Width="60" Height="60" CornerRadius="20" Background="#222222" HorizontalAlignment="Center">
            <TextBlock Text="▶" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{x:Static core:UiText.DropAVideoHere}" FontSize="18" FontWeight="SemiBold" Foreground="#F2F2F2" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static core:UiText.DropASubtitleFileWhileAVideoIs}" FontSize="13" Foreground="#999999" HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="InteractiveSubtitleHost" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="Transparent" CornerRadius="10" Padding="12,4" />
        <Border x:Name="DropOverlay" IsVisible="False" Background="#B0141414" CornerRadius="18">
          <TextBlock x:Name="DropOverlayText" Text="{x:Static core:UiText.DropAVideoOrSubtitleFile}" FontSize="18" Foreground="#F2F2F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="CaptureNotification" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                IsVisible="False" IsHitTestVisible="False"
                Background="Transparent" BorderThickness="0" Padding="0">
          <Border x:Name="CaptureThumbnailBorder" Width="112" Height="63" CornerRadius="6"
                  ClipToBounds="True" BorderBrush="#3A3A3A" BorderThickness="1" Background="#141414"
                  IsVisible="False">
            <Image x:Name="CaptureThumbnail" Stretch="Uniform" />
          </Border>
        </Border>
        <Border x:Name="VolumeNotification" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
                IsVisible="False" IsHitTestVisible="False"
                Background="#E51B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="14,10">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock x:Name="VolumeNotificationIcon" Text="🔊" FontSize="15" VerticalAlignment="Center" />
            <TextBlock x:Name="VolumeNotificationText" Text="100%" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border x:Name="StatusNotification" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                IsVisible="False" IsHitTestVisible="False"
                Background="#E51B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="16,10">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusNotificationText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Canvas x:Name="WordCardLayer" IsHitTestVisible="False" ClipToBounds="True">
          <Border x:Name="WordCard" IsVisible="False" Opacity="0" MinWidth="190" MaxWidth="380"
                  Background="#F2151515" BorderBrush="#454545" BorderThickness="1" CornerRadius="16" Padding="16,13">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
              </Transitions>
            </Border.Transitions>
            <Border.Effect>
              <DropShadowEffect BlurRadius="28" OffsetX="0" OffsetY="8" Color="#000000" Opacity="0.55" />
            </Border.Effect>
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="WordCardWord" FontSize="13" FontWeight="SemiBold" Foreground="#FFD54A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border x:Name="WordCardBadge" Grid.Column="1" CornerRadius="8" Padding="7,2" Background="#33FFD54A" IsVisible="False" VerticalAlignment="Center">
                  <TextBlock x:Name="WordCardBadgeText" FontSize="10" FontWeight="Bold" Foreground="#FFD54A" />
                </Border>
              </Grid>
              <TextBlock x:Name="WordCardTranslation" FontSize="22" FontWeight="SemiBold" Foreground="#F5F5F5" TextWrapping="Wrap" />
              <TextBlock x:Name="WordCardAlternatives" FontSize="12" Foreground="#A7A7A7" TextWrapping="Wrap" IsVisible="False" />
              <Border Height="1" Background="#2D2D2D" />
              <TextBlock x:Name="WordCardHint" FontSize="11" Foreground="#858585" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="SentenceCard" IsVisible="False" Width="380" MaxWidth="380"
                  Background="#F2151515" BorderBrush="#454545" BorderThickness="1" CornerRadius="16" Padding="16,13">
            <Border.Effect>
              <DropShadowEffect BlurRadius="28" OffsetX="0" OffsetY="8" Color="#000000" Opacity="0.55" />
            </Border.Effect>
            <StackPanel Spacing="7">
              <TextBlock x:Name="SentenceCardText" FontSize="13" FontWeight="SemiBold" Foreground="#FFD54A" TextWrapping="Wrap" />
              <TextBlock x:Name="SentenceCardTranslation" FontSize="18" FontWeight="SemiBold" Foreground="#F5F5F5" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Canvas>
      </Grid>
    </Border>

    <Border x:Name="SubtitleSyncNotification" Grid.Row="1" Grid.Column="0" ZIndex="6"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
            IsVisible="False" IsHitTestVisible="False"
            Background="#E51B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="16,11">
      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static core:UiText.SubtitleTiming}" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F2" />
        <TextBlock x:Name="SubtitleSyncCurrentLabel" FontSize="12" Foreground="#F2F2F2" />
        <TextBlock x:Name="SubtitleSyncChangeLabel" FontSize="11" Foreground="#A7A7A7" />
      </StackPanel>
    </Border>

    <Border x:Name="QueuePanel" Grid.Row="1" Grid.Column="1" Width="292" Margin="10,8,0,0" Padding="12"
            HorizontalAlignment="Right"
            Background="#181818" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="14"
            IsVisible="False" Opacity="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,10">
          <TextBlock Text="{x:Static core:UiText.PlaybackQueue}" FontSize="15" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
          <Button x:Name="QueuePanelPinButton" Grid.Column="1" Content="&#x25C7;" Width="34" Height="32" Padding="0" ToolTip.Tip="{x:Static core:UiText.PinPanel}" AutomationProperties.Name="{x:Static core:UiText.PinPlaybackQueue}" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="2,0,2,10">
          <TextBlock Text="{x:Static core:UiText.NowPlaying}" Foreground="#A7A7A7" FontSize="11" />
          <TextBlock x:Name="QueueItemsCountLabel" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="3" Margin="2,0,2,10">
          <TextBlock x:Name="QueueCurrentLabel" Text="{x:Static core:UiText.NowPlaying}" Foreground="#F2F2F2" FontSize="12"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{x:Static core:UiText.CurrentlyPlayingVideo}" />
          <TextBlock x:Name="QueueCurrentFolderLabel" Foreground="#858585" FontSize="10" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button x:Name="OpenPlaylistButton" Content="{x:Static core:UiText.OpenPlaylist}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="{x:Static core:UiText.OpenM3UPlaylist}" AutomationProperties.Name="{x:Static core:UiText.OpenPlaylist}" />
          <Button x:Name="SavePlaylistButton" Content="{x:Static core:UiText.SaveQueue}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="{x:Static core:UiText.SaveTheCurrentVideoAndQueueAsAn}"
                  AutomationProperties.Name="{x:Static core:UiText.SaveQueueAsM3u}" />
        </StackPanel>
        <Grid Grid.Row="4">
          <TextBlock x:Name="QueueEmptyNotice" Text="{x:Static core:UiText.QueueIsEmpty}" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     Foreground="#858585" FontSize="12" Margin="18" IsVisible="False" />
          <ListBox x:Name="QueueItems" Background="#101010" Foreground="#F2F2F2"
                   BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="10"
                   ToolTip.Tip="{x:Static core:UiText.ClickToPlayDragToReorderClickTo}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:QueueListItem">
                <Grid ColumnDefinitions="24,*,Auto" Margin="3,3">
                  <TextBlock Text="{Binding Position}" VerticalAlignment="Top" HorizontalAlignment="Center"
                             Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="4,3,6,3">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Path}" />
                    <TextBlock Text="{Binding Folder}" Foreground="#858585" FontSize="10" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Folder}" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="&#xD7;" Tag="{Binding Index}" Width="32" Height="32" Padding="0"
                          ToolTip.Tip="{x:Static core:UiText.RemoveFromQueue}" AutomationProperties.Name="{x:Static core:UiText.RemoveVideoFromQueue}" Click="OnQueueRemoveClick" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </Border>

    <Grid x:Name="BottomBar" Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto"
          HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Panel.ZIndex="5" Margin="12,4,12,5"
          IsVisible="False" Opacity="0">
      <Border Background="#E6191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="16" Padding="14,3,14,4" ClipToBounds="True">
        <Grid>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
            <Button x:Name="PlayButton" Content="&#x25B6;" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.PlayOrPause}" AutomationProperties.Name="{x:Static core:UiText.Play}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" />
            <TextBlock x:Name="TimeLabel" Grid.Column="1" Text="00:00 / 00:00" Foreground="#C4C4C4" FontSize="12" VerticalAlignment="Center" Margin="8,0" Background="Transparent" />
            <TextBlock x:Name="SpeedLabel" Grid.Column="2" Text="1.00&#215;" Foreground="#A7A7A7" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
            <Grid Grid.Column="3" MinHeight="20">
              <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" Value="0" IsEnabled="False" ToolTip.Tip="{x:Static core:UiText.DragToSeekHoldAndPullUpwardFor}" AutomationProperties.Name="{x:Static core:UiText.PlaybackPosition}">
                <Slider.Resources>
                  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E53935" />
                  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#E53935" />
                  <SolidColorBrush x:Key="SliderThumbBackground" Color="#E53935" />
                  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E53935" />
                  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E53935" />
                </Slider.Resources>
              </Slider>
              <Canvas x:Name="ChapterMarkers" IsHitTestVisible="False" />
              <Border x:Name="SeekPreviewPanel" Grid.ColumnSpan="5" IsVisible="False" Width="1380" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#181818" BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8" IsHitTestVisible="False">
                <StackPanel Spacing="4">
                  <ItemsControl x:Name="SeekPreviewItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:TimelinePreviewFrame">
                        <StackPanel Width="154" Spacing="4">
                          <Border Height="92" CornerRadius="6" Background="#090909" ClipToBounds="True"><Image Source="{Binding Bitmap}" Stretch="UniformToFill" /></Border>
                          <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="10" Foreground="#D0D0D0" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="SeekPreviewTime" Text="{x:Static core:UiText.LoadingNearbyFrames}" HorizontalAlignment="Center" FontSize="10" Foreground="#999999" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid x:Name="BrightnessControl" Grid.Column="4" ColumnDefinitions="Auto,*,Auto" Width="134" VerticalAlignment="Center">
              <TextBlock Text="🔆" FontSize="13" Foreground="#A7A7A7" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="{x:Static core:UiText.Brightness}" />
              <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ToolTip.Tip="{x:Static core:UiText.BrightnessHelp}" AutomationProperties.Name="{x:Static core:UiText.Brightness}" />
              <TextBlock x:Name="BrightnessLabel" Grid.Column="2" Text="100%" FontSize="11" Foreground="#A7A7A7" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <Grid x:Name="VolumeControl" Grid.Column="5" ColumnDefinitions="*,Auto" Width="128" VerticalAlignment="Center">
              <Slider x:Name="VolumeSlider" Grid.Column="0" Minimum="0" Maximum="150" Value="100" VerticalAlignment="Center" ToolTip.Tip="{x:Static core:UiText.Volume0150ScrollOverTheSliderTo}" AutomationProperties.Name="{x:Static core:UiText.Volume}" />
              <TextBlock x:Name="VolumeLabel" Grid.Column="1" Text="100%" FontSize="11" Foreground="#A7A7A7" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <Button x:Name="AudioTrackButton" Grid.Column="6" Content="🔊" Width="36" Height="36" Padding="0" FontSize="16" ToolTip.Tip="{x:Static core:UiText.SelectAudioTrack}" AutomationProperties.Name="{x:Static core:UiText.AudioTrack}" IsVisible="False" />
            <Button x:Name="SubtitleButton" Grid.Column="7" Content="CC" Width="36" Height="36" Padding="0" FontSize="12" FontWeight="Bold" ToolTip.Tip="{x:Static core:UiText.ShowOrHideSubtitles}" AutomationProperties.Name="{x:Static core:UiText.ShowSubtitles}" />
            <Button x:Name="VocabularyButton" Grid.Column="8" Content="📖" Width="36" Height="36" Padding="0" FontSize="15" ToolTip.Tip="Bilinmeyen kelimeler listesi" AutomationProperties.Name="Bilinmeyen kelimeler listesi" />
            <Button x:Name="HardwareAccelerationButton" Grid.Column="9" Content="&#x25A6;" Width="36" Height="36" Padding="0" FontSize="17" ToolTip.Tip="{x:Static core:UiText.ToggleHardwareAcceleration}" AutomationProperties.Name="{x:Static core:UiText.EnableHardwareAcceleration}" />
          </Grid>
          <Popup x:Name="AudioTrackPickerPopup" PlacementTarget="{Binding #AudioTrackButton}" Placement="TopEdgeAlignedRight" VerticalOffset="-8" IsOpen="False" IsLightDismissEnabled="True">
            <Border x:Name="AudioTrackPickerContent" Background="#181818" BorderBrush="#383838" BorderThickness="1" CornerRadius="12" Padding="12" Width="300" MaxHeight="260">
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Static core:UiText.AudioTrack}" FontWeight="SemiBold" FontSize="13" Foreground="#F2F2F2" />
                <ListBox x:Name="AudioTrackList" MaxHeight="210" Background="#121212" Foreground="#F2F2F2"
                         BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="{x:Static core:UiText.SelectAudioTrack}" />
              </StackPanel>
            </Border>
          </Popup>
          <Popup x:Name="SubtitlePickerPopup" PlacementTarget="{Binding #SubtitleButton}" Placement="TopEdgeAlignedRight" VerticalOffset="-8" IsOpen="False" IsLightDismissEnabled="True">
            <Border x:Name="SubtitlePickerContent" Background="#181818" BorderBrush="#383838" BorderThickness="1" CornerRadius="14" Padding="14" Width="700" MaxHeight="580">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                  <!-- Başlık ve Hızlı Görünürlük -->
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Altyazı Yönetimi" FontWeight="SemiBold" FontSize="14" Foreground="#F2F2F2" />
                      <TextBlock x:Name="ActiveSubtitleSummaryLabel" Text="Aktif altyazı yok" FontSize="11" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="ToggleSubtitlesVisibilityButton" Grid.Column="1" Content="Altyazı: Açık" Height="30" Padding="12,0" FontSize="12" ToolTip.Tip="Altyazı görünürlüğünü aç/kapat" />
                    <Button x:Name="CloseSubtitlePopupButton" Grid.Column="2" Content="✕" Width="30" Height="30" Padding="0" Classes="caption" ToolTip.Tip="Paneli kapat (Esc)" />
                  </Grid>

                  <Border Height="1" Background="#2D2D2D" />

                  <!-- İki Sütunlu Ana İçerik -->
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Sol Sütun: Parçalar, Klasör Dosyaları ve Hızlı Ayarlar -->
                    <StackPanel Grid.Column="0" Spacing="10">
                      <!-- Mevcut Altyazı Parçaları -->
                      <Border Background="#131313" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="10">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Mevcut Altyazı Parçaları" FontSize="12" FontWeight="SemiBold" Foreground="#B5B5B5" />
                          <TextBlock x:Name="NoSubtitlesNotice" Text="Gömülü veya yüklü altyazı parçası yok." Foreground="#7A7A7A" FontSize="11" IsVisible="False" Margin="2,0" />
                          <ListBox x:Name="SubtitleTrackList" MaxHeight="116" Background="#0F0F0F" Foreground="#F2F2F2"
                                   BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="{x:Static core:UiText.SelectSubtitleTrack}" />
                        </StackPanel>
                      </Border>

                      <!-- Klasördeki Altyazılar + Dosya Ekle -->
                      <Border Background="#131313" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="10">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Klasörde Bulunan Altyazılar" FontSize="12" FontWeight="SemiBold" Foreground="#B5B5B5" VerticalAlignment="Center" />
                            <Button x:Name="AddSubtitleButton" Grid.Column="1" Content="+ Dosya Ekle..." Height="26" Padding="10,0" FontSize="11" ToolTip.Tip="Bilgisayardan altyazı dosyası seç" />
                          </Grid>
                          <TextBlock x:Name="NoLocalSubtitlesNotice" Text="Video klasöründe altyazı dosyası bulunamadı." Foreground="#7A7A7A" FontSize="11" IsVisible="False" Margin="2,0" />
                          <ListBox x:Name="LocalFolderSubtitleList" MaxHeight="106" Background="#0F0F0F" Foreground="#F2F2F2"
                                   BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" />
                        </StackPanel>
                      </Border>

                      <!-- Zamanlama ve Görünüm -->
                      <Border Background="#131313" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="10">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Hızlı Ayarlar (Zamanlama &amp; Görünüm)" FontSize="12" FontWeight="SemiBold" Foreground="#B5B5B5" />
                          <Grid ColumnDefinitions="74,Auto,*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Text="Zamanlama" FontSize="11.5" Foreground="#A7A7A7" VerticalAlignment="Center" />
                            <Button x:Name="SubtitleDelayEarlierButton" Grid.Column="1" Content="−" Width="30" Height="28" Padding="0" FontSize="13" ToolTip.Tip="Altyazıyı erkene al" />
                            <TextBlock x:Name="SubtitleDelayValueLabel" Grid.Column="2" Text="+0.00 sn" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="SubtitleDelayLaterButton" Grid.Column="3" Content="+" Width="30" Height="28" Padding="0" FontSize="13" ToolTip.Tip="Altyazıyı geciktir" />
                            <Button x:Name="SubtitleDelayResetButton" Grid.Column="4" Content="Sıfırla" Height="28" Padding="9,0" FontSize="11" ToolTip.Tip="Zamanlamayı sıfırla" />
                          </Grid>
                          <Grid ColumnDefinitions="74,Auto,*,Auto" ColumnSpacing="6">
                            <TextBlock Text="Yazı Boyutu" FontSize="11.5" Foreground="#A7A7A7" VerticalAlignment="Center" />
                            <Button x:Name="SubtitleFontSmallerButton" Grid.Column="1" Content="A−" Width="34" Height="28" Padding="0" FontSize="11" ToolTip.Tip="Yazı boyutunu küçült" />
                            <TextBlock x:Name="SubtitleFontSizeLabel" Grid.Column="2" Text="42 px" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="SubtitleFontLargerButton" Grid.Column="3" Content="A+" Width="34" Height="28" Padding="0" FontSize="11" ToolTip.Tip="Yazı boyutunu büyüt" />
                          </Grid>
                          <Grid ColumnDefinitions="74,*" ColumnSpacing="6">
                            <TextBlock Text="Kodlama" FontSize="11.5" Foreground="#A7A7A7" VerticalAlignment="Center" />
                            <ComboBox x:Name="SubtitleCodepageSelector" Grid.Column="1" HorizontalAlignment="Stretch" Height="30" FontSize="11.5" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Sağ Sütun: Online Arama, Senkronizasyon ve Kelime Çevirisi -->
                    <StackPanel Grid.Column="1" Spacing="10">
                      <!-- Online Arama -->
                      <Border Background="#131313" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="10">
                        <StackPanel Spacing="7">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Online Altyazı (OpenSubtitles)" FontSize="12" FontWeight="SemiBold" Foreground="#B5B5B5" VerticalAlignment="Center" />
                            <ComboBox x:Name="SubtitleSearchLanguageSelector" Grid.Column="1" Width="112" Height="28" FontSize="11" ToolTip.Tip="Arama dili" />
                          </Grid>
                          <CheckBox x:Name="AutoFindSubtitlesCheckBox" Content="Video açılınca otomatik ara ve indir" FontSize="11.5" Margin="2,0" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox x:Name="SubtitleSearchQueryBox" PlaceholderText="Film / dizi adı girin..." Height="32" FontSize="12" VerticalContentAlignment="Center" />
                            <Button x:Name="ManualSubtitleSearchButton" Grid.Column="1" Content="Ara" Height="32" Padding="14,0" />
                          </Grid>
                          <Button x:Name="FindSubtitleButton" Content="Videoya Göre Otomatik Ara" HorizontalAlignment="Stretch" Height="32" />
                          <ListBox x:Name="OnlineSearchResultsList" MaxHeight="140" Background="#0F0F0F" Foreground="#F2F2F2"
                                   BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" IsVisible="False" />
                        </StackPanel>
                      </Border>

                      <!-- Altyazı Senkronizasyonu -->
                      <Border Background="#131313" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="10">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Altyazı Senkronizasyonu" FontSize="12" FontWeight="SemiBold" Foreground="#B5B5B5" />
                          <CheckBox x:Name="AutoSynchronizeSubtitlesCheckBox" Content="Harici altyazıyı otomatik senkronize et" FontSize="11.5" Margin="2,0" />
                          <Button x:Name="SynchronizeSubtitleButton" Content="Otomatik Altyazı Senkronizasyonu" HorizontalAlignment="Stretch" Height="32" />
                        </StackPanel>
                      </Border>

                      <!-- Kelime Çevirisi -->
                      <Border Background="#131313" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="10">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Kelime Çevirisi" FontSize="12" FontWeight="SemiBold" Foreground="#B5B5B5" />
                          <CheckBox x:Name="InteractiveSubtitlesCheckBox" Content="Etkileşimli altyazı (üzerine gel: çeviri, tıkla: ekle)" FontSize="11.5" Margin="2,0" />
                          <Button x:Name="OpenVocabularyButton" Content="Bilinmeyen Kelimeler Listesi" HorizontalAlignment="Stretch" Height="32" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>

                  <!-- Birleşik Durum Çubuğu -->
                  <Border x:Name="SubtitleAutomationStatusBanner" IsVisible="False" Background="#12231D" BorderBrush="#1F4D3D" BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <TextBlock x:Name="SubtitleAutomationStatus" TextWrapping="Wrap" Foreground="#00BC7D" FontSize="11.5" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

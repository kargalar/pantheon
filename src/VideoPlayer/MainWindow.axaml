<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:VideoPlayer"
        xmlns:core="clr-namespace:VideoPlayer.Core;assembly=VideoPlayer.Core"
        x:Class="VideoPlayer.MainWindow"
        Title="Pantheon" Icon="/Assets/pantheon.ico" Width="1120" Height="760" MinWidth="920" MinHeight="560"
        WindowDecorations="None" ExtendClientAreaToDecorationsHint="True" CanResize="True" ShowInTaskbar="True"
        Background="#090909" WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootPanel" RowDefinitions="48,*,Auto" ColumnDefinitions="*,Auto" Margin="0">
    <Border x:Name="HeaderBar" Grid.Row="0" Grid.ColumnSpan="2" Background="#181818" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="14,14,10,10"
            IsVisible="False" Opacity="0">
      <Grid ColumnDefinitions="*,Auto">
        <Border x:Name="TitleDragRegion" Background="Transparent">
          <TextBlock x:Name="WindowFileLabel" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2"
                     Margin="15,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,7,0" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Content="⚙" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.Settings}" AutomationProperties.Name="{x:Static core:UiText.Settings}" />
          <Button x:Name="MinimizeButton" Content="−" Classes="caption" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.Minimize}" AutomationProperties.Name="{x:Static core:UiText.Minimize}" />
          <Button x:Name="MaximizeButton" Content="□" Classes="caption" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.Maximize}" AutomationProperties.Name="{x:Static core:UiText.Maximize}" />
          <Button x:Name="CloseButton" Content="×" Classes="caption close" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.Close}" AutomationProperties.Name="{x:Static core:UiText.CloseWindow}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="VideoFrame" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" CornerRadius="0" Background="#090909" BorderThickness="0" ClipToBounds="True">
      <Grid>
        <local:ToneMappedVideoView x:Name="VideoSurface" />
        <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
          <Border Width="60" Height="60" CornerRadius="20" Background="#222222" HorizontalAlignment="Center">
            <TextBlock Text="▶" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{x:Static core:UiText.DropAVideoHere}" FontSize="18" FontWeight="SemiBold" Foreground="#F2F2F2" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static core:UiText.DropASubtitleFileWhileAVideoIs}" FontSize="13" Foreground="#999999" HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="DropOverlay" IsVisible="False" Background="#B0141414" CornerRadius="18">
          <TextBlock x:Name="DropOverlayText" Text="{x:Static core:UiText.DropAVideoOrSubtitleFile}" FontSize="18" Foreground="#F2F2F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="CaptureNotification" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                IsVisible="False" IsHitTestVisible="False"
                Background="Transparent" BorderThickness="0" Padding="0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border x:Name="CaptureThumbnailBorder" Width="112" Height="63" CornerRadius="6"
                    ClipToBounds="True" IsVisible="False">
              <Image x:Name="CaptureThumbnail" Stretch="Uniform" />
            </Border>
            <Ellipse x:Name="CaptureNotificationIndicator" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="CaptureNotificationText" Text="{x:Static core:UiText.CapturingFrame}" FontSize="12" Foreground="#F2F2F2" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border x:Name="VolumeNotification" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
                IsVisible="False" IsHitTestVisible="False"
                Background="#E51B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="14,10">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock x:Name="VolumeNotificationIcon" Text="🔊" FontSize="15" VerticalAlignment="Center" />
            <TextBlock x:Name="VolumeNotificationText" Text="100%" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border x:Name="StatusNotification" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                IsVisible="False" IsHitTestVisible="False"
                Background="#E51B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="16,10">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusNotificationText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="SubtitleSyncNotification" Grid.Row="1" Grid.Column="0" ZIndex="6"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
            IsVisible="False" IsHitTestVisible="False"
            Background="#E51B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="16,11">
      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static core:UiText.SubtitleTiming}" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F2" />
        <TextBlock x:Name="SubtitleSyncCurrentLabel" FontSize="12" Foreground="#F2F2F2" />
        <TextBlock x:Name="SubtitleSyncChangeLabel" FontSize="11" Foreground="#A7A7A7" />
      </StackPanel>
    </Border>

    <Border x:Name="QueuePanel" Grid.Row="1" Grid.Column="1" Width="292" Margin="10,8,0,0" Padding="12"
            HorizontalAlignment="Right"
            Background="#181818" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="14"
            IsVisible="False" Opacity="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,10">
          <TextBlock Text="{x:Static core:UiText.PlaybackQueue}" FontSize="15" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
          <Button x:Name="QueuePanelPinButton" Grid.Column="1" Content="◇" Width="34" Height="32" Padding="0" ToolTip.Tip="{x:Static core:UiText.PinPanel}" AutomationProperties.Name="{x:Static core:UiText.PinPlaybackQueue}" />
        </Grid>
        <TextBlock x:Name="QueueCurrentLabel" Grid.Row="1" Text="{x:Static core:UiText.NowPlaying}" Foreground="#A7A7A7" FontSize="11"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{x:Static core:UiText.CurrentlyPlayingVideo}" Margin="2,0,2,8" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button x:Name="OpenPlaylistButton" Content="{x:Static core:UiText.OpenPlaylist}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="{x:Static core:UiText.OpenM3UPlaylist}" AutomationProperties.Name="{x:Static core:UiText.OpenPlaylist}" />
          <Button x:Name="SavePlaylistButton" Content="{x:Static core:UiText.SaveQueue}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="{x:Static core:UiText.SaveTheCurrentVideoAndQueueAsAn}"
                  AutomationProperties.Name="{x:Static core:UiText.SaveQueueAsM3u}" />
        </StackPanel>
        <ListBox x:Name="QueueItems" Grid.Row="3" Background="#101010" Foreground="#F2F2F2"
                 BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="10"
                 ToolTip.Tip="{x:Static core:UiText.ClickToPlayDragToReorderClickTo}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:QueueListItem">
              <Grid ColumnDefinitions="*,Auto" Margin="3,2">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                <Button Grid.Column="1" Content="×" Tag="{Binding Index}" Width="32" Height="32" Padding="0"
                        ToolTip.Tip="{x:Static core:UiText.RemoveFromQueue}" AutomationProperties.Name="{x:Static core:UiText.RemoveVideoFromQueue}" Click="OnQueueRemoveClick" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid x:Name="BottomBar" Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto"
          HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Panel.ZIndex="5" Margin="12,4,12,5"
          IsVisible="False" Opacity="0">
      <Border Background="#E6191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="16" Padding="14,3,14,4">
        <Grid>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
            <Button x:Name="PlayButton" Content="&#x25B6;" Width="36" Height="36" Padding="0" ToolTip.Tip="{x:Static core:UiText.PlayOrPause}" AutomationProperties.Name="{x:Static core:UiText.Play}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" />
            <TextBlock x:Name="TimeLabel" Grid.Column="1" Text="00:00 / 00:00" Foreground="#C4C4C4" FontSize="12" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock x:Name="SpeedLabel" Grid.Column="2" Text="1.00&#215;" Foreground="#A7A7A7" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
            <Grid Grid.Column="3" MinHeight="20">
              <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" Value="0" IsEnabled="False" ToolTip.Tip="{x:Static core:UiText.DragToSeekHoldAndPullUpwardFor}" AutomationProperties.Name="{x:Static core:UiText.PlaybackPosition}" />
              <Canvas x:Name="ChapterMarkers" IsHitTestVisible="False" />
              <Border x:Name="SeekPreviewPanel" Grid.ColumnSpan="5" IsVisible="False" Width="1380" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#181818" BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8" IsHitTestVisible="False">
                <StackPanel Spacing="4">
                  <ItemsControl x:Name="SeekPreviewItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:TimelinePreviewFrame">
                        <StackPanel Width="154" Spacing="4">
                          <Border Height="92" CornerRadius="6" Background="#090909" ClipToBounds="True"><Image Source="{Binding Bitmap}" Stretch="UniformToFill" /></Border>
                          <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="10" Foreground="#D0D0D0" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="SeekPreviewTime" Text="{x:Static core:UiText.LoadingNearbyFrames}" HorizontalAlignment="Center" FontSize="10" Foreground="#999999" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid Grid.Column="4" ColumnDefinitions="*,Auto" Width="128" VerticalAlignment="Center">
              <Slider x:Name="VolumeSlider" Grid.Column="0" Minimum="0" Maximum="150" Value="100" VerticalAlignment="Center" ToolTip.Tip="{x:Static core:UiText.Volume0150ScrollOverTheSliderTo}" AutomationProperties.Name="{x:Static core:UiText.Volume}" />
              <TextBlock x:Name="VolumeLabel" Grid.Column="1" Text="100%" FontSize="11" Foreground="#A7A7A7" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <Button x:Name="AudioTrackButton" Grid.Column="5" Content="🔊" Width="36" Height="36" Padding="0" FontSize="16" ToolTip.Tip="{x:Static core:UiText.SelectAudioTrack}" AutomationProperties.Name="{x:Static core:UiText.AudioTrack}" IsVisible="False" />
            <Button x:Name="SubtitleButton" Grid.Column="6" Content="CC" Width="36" Height="36" Padding="0" FontSize="12" FontWeight="Bold" ToolTip.Tip="{x:Static core:UiText.ShowOrHideSubtitles}" AutomationProperties.Name="{x:Static core:UiText.ShowSubtitles}" />
            <Button x:Name="HardwareAccelerationButton" Grid.Column="7" Content="&#x25A6;" Width="36" Height="36" Padding="0" FontSize="17" ToolTip.Tip="{x:Static core:UiText.ToggleHardwareAcceleration}" AutomationProperties.Name="{x:Static core:UiText.EnableHardwareAcceleration}" />
          </Grid>
          <Popup x:Name="AudioTrackPickerPopup" PlacementTarget="{Binding #AudioTrackButton}" Placement="Top" IsOpen="False" IsLightDismissEnabled="True">
            <Border Background="#181818" BorderBrush="#383838" BorderThickness="1" CornerRadius="12" Padding="12" Width="300" MaxHeight="260">
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Static core:UiText.AudioTrack}" FontWeight="SemiBold" FontSize="13" Foreground="#F2F2F2" />
                <ListBox x:Name="AudioTrackList" MaxHeight="210" Background="#121212" Foreground="#F2F2F2"
                         BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="{x:Static core:UiText.SelectAudioTrack}" />
              </StackPanel>
            </Border>
          </Popup>
          <Popup x:Name="SubtitlePickerPopup" PlacementTarget="{Binding #SubtitleButton}" Placement="Top" IsOpen="False" IsLightDismissEnabled="True">
            <Border x:Name="SubtitlePickerContent" Background="#181818" BorderBrush="#383838" BorderThickness="1" CornerRadius="12" Padding="12" Width="360" MaxHeight="520">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Altyazı Yönetimi" FontWeight="SemiBold" FontSize="13" Foreground="#F2F2F2" VerticalAlignment="Center" />
                    <Button x:Name="CloseSubtitlePopupButton" Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" Classes="caption" />
                  </Grid>

                  <Border Height="1" Background="#2D2D2D" />

                  <!-- Mevcut Altyazılar -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Mevcut Altyazı Parçaları" FontSize="12" FontWeight="SemiBold" Foreground="#A7A7A7" />
                    <TextBlock x:Name="NoSubtitlesNotice" Text="Mevcut veya seçili altyazı yok." Foreground="#707070" FontSize="11" IsVisible="False" Margin="4,2" />
                    <ListBox x:Name="SubtitleTrackList" MaxHeight="130" Background="#121212" Foreground="#F2F2F2"
                             BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="{x:Static core:UiText.SelectSubtitleTrack}" />
                  </StackPanel>

                  <!-- Klasördeki Altyazılar -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Klasörde Bulunan Altyazılar" FontSize="12" FontWeight="SemiBold" Foreground="#A7A7A7" />
                    <TextBlock x:Name="NoLocalSubtitlesNotice" Text="Video klasöründe altyazı dosyası bulunamadı." Foreground="#707070" FontSize="11" IsVisible="False" Margin="4,2" />
                    <ListBox x:Name="LocalFolderSubtitleList" MaxHeight="110" Background="#121212" Foreground="#F2F2F2"
                             BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" />
                  </StackPanel>

                  <!-- Online Arama -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Online Altyazı (OpenSubtitles)" FontSize="12" FontWeight="SemiBold" Foreground="#A7A7A7" />
                    <CheckBox x:Name="AutoFindSubtitlesCheckBox" Content="Video açılınca otomatik ara ve indir" FontSize="11" Margin="2,0" />
                    <Button x:Name="FindSubtitleButton" Content="Otomatik Online Ara" HorizontalAlignment="Stretch" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBox x:Name="SubtitleSearchQueryBox" PlaceholderText="Film / dizi adı girin..." Height="32" FontSize="12" VerticalContentAlignment="Center" />
                      <Button x:Name="ManualSubtitleSearchButton" Grid.Column="1" Content="Ara" Height="32" Padding="12,0" />
                    </Grid>

                    <TextBlock x:Name="SubtitleAutomationStatus" IsVisible="False" TextWrapping="Wrap"
                               Foreground="#00BC7D" FontSize="11" Margin="2,0" />

                    <ListBox x:Name="OnlineSearchResultsList" MaxHeight="140" Background="#121212" Foreground="#F2F2F2"
                             BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" IsVisible="False" />
                  </StackPanel>

                  <Border Height="1" Background="#2D2D2D" />

                  <!-- Altyazı Senkronizasyonu -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Altyazı Senkronizasyonu" FontSize="12" FontWeight="SemiBold" Foreground="#A7A7A7" />
                    <Button x:Name="SynchronizeSubtitleButton" Content="Otomatik Altyazı Senkronizasyonu" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="SubtitleSyncStatus" IsVisible="False" TextWrapping="Wrap"
                               Foreground="#00BC7D" FontSize="11" Margin="2,0" />
                  </StackPanel>

                  <Border Height="1" Background="#2D2D2D" />

                  <!-- Altyazı Ekle -->
                  <Button x:Name="AddSubtitleButton" Content="Altyazı Dosyası Ekle..." HorizontalAlignment="Stretch" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
